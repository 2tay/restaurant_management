  FROM goods_receipt_lines WHERE rowid = NEW.rowid
  ON CONFLICT (changed_table, row_key) DO UPDATE SET
    store_id = excluded.store_id,
    payload = excluded.payload,
    queued_at = excluded.queued_at,
    attempts = 0,
    last_error = NULL;
END;

