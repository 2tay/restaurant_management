-- The "one per" rules, for live rows only (SYNC_PLAN.md, Phase 7, schema v19).
--
-- They used to be ordinary unique indexes, which count soft-deleted rows too.
-- Two tablets working offline can both create "the" row for the same key: two
-- clock-ins for one employee on one day, the same supplier linked twice to one
-- article, a password set twice. Sync keeps one and marks the other deleted
-- (`SyncApplier`), and a deleted row must not keep occupying the key.

import 'tables/attendance.dart';
import 'tables/employees.dart';
import 'tables/suppliers.dart';

CREATE UNIQUE INDEX attendances_employee_date
  ON attendances (employee_id, date) WHERE deleted_at IS NULL;

CREATE UNIQUE INDEX supplier_prices_pair
  ON supplier_prices (item_id, supplier_id) WHERE deleted_at IS NULL;

CREATE UNIQUE INDEX employee_credentials_employee
  ON employee_credentials (employee_id) WHERE deleted_at IS NULL;
